# =============================================================================
# Unified ML-IDS + GenAI-IDS environment configuration
# Copy to .env and adjust.
# =============================================================================

# --- Model selection ---------------------------------------------------------
# "ft_transformer" | "xgboost" | "auto"  (auto tries FT-T then falls back to XGB)
MODEL_BACKEND=auto

# --- Paths (defaults resolve relative to the repository root) ---------------
# MODELS_DIR=./models
# FTTRANSFORMER_CKPT=./models/ft_transformer/unified_ft_transformer.pt
# FTTRANSFORMER_SCALER=./models/ft_transformer/unified_scaler.pkl
# XGBOOST_MODEL=./models/baseline/ids_xgboost_genai.pkl
# XGBOOST_SCALER=./models/baseline/feature_scaler_genai.pkl
# XGBOOST_LABEL_ENCODER=./models/baseline/label_encoder_genai.pkl

# --- IBM Granite LLM advisory (strictly advisory layer) -----------------------
LLM_ENABLED=true
# LLM_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29
LLM_API_KEY=
LLM_PROJECT_ID=
LLM_MODEL_ID=ibm/granite-20b-code-instruct-v2
LLM_MAX_NEW_TOKENS=1024
LLM_TIMEOUT=20
LLM_ADVISORY_TOP_N=6

# --- API security ------------------------------------------------------------
AUTH_ENABLED=true
# Comma-separated list of accepted keys
ML_IDS_API_KEYS=dev-key-change-me

# --- Persistence -------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./mlids.db

# --- Alerting -----------------------------------------------------------------
ALERT_DEDUP_WINDOW_SECONDS=300
ALERT_CREATE_ON_ATTACK=true

# --- Incident correlation ------------------------------------------------------
ALERT_CORRELATION_ENABLED=true
ALERT_CORRELATION_MIN_ALERTS=2
ALERT_CORRELATION_WINDOW_HOURS=24

# --- Notifications (all optional; recommended actions remain analyst-approved) -
# ALERT_NOTIFICATION_ENABLED=true
# SLACK_WEBHOOK_URL=
# NOTIFICATION_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
# SMTP_USE_SSL=false
# SMTP_STARTTLS=true

# --- Logging ------------------------------------------------------------------
LOG_NEGATIVE_PREDICTIONS=false